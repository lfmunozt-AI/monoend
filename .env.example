LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OPENAI_API_KEY=
# Rate limit del chat (plan free): "true" desactiva el tope de 20/dia (QA/dev).
RATE_LIMIT_DISABLED=
# user_ids exentos del rate limit incluso en Production (coma-separado).
ADMIN_USER_IDS=
# Modo de enforcement de las capas de guardarraíl (AG08).
#   full    (por defecto, producción): todas las capas activas.
#   minimal (experimento A/B): solo BLOQUEO — siguen activos el guardarraíl de
#           entrada (inyección), el grounding de bloqueo puro, el validador de
#           seguridad (garantías/absolutos/branding/identidad) y The
#           Commandments; se desactivan ensureSubstance, la sustitución de
#           cierres y la sustitución de cifras (la frase se ELIMINA, la cifra
#           nunca se reescribe). El modo aplicado se registra por turno en
#           response_telemetry.enforcement_mode.
ENFORCEMENT_MODE=full
# Telemetría del piloto (G1b)
CRON_SECRET=            # protege las rutas /api/cron/* (cadena aleatoria larga)
PILOT_ALERT_EMAIL=      # destinatario del digest nocturno de revisión
RESEND_API_KEY=         # envío del digest (cuenta Resend)
